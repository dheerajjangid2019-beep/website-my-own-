# Copy this file to .env and replace the value with a strong, private password.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional: enables the AI Designer. Keep this key on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PORT=3000
# Local preview only: automatically reload the browser when frontend files change.
NODE_ENV=development
# Optional. Production defaults to 0.0.0.0; local development defaults to 127.0.0.1.
# HOST=127.0.0.1
# Set this to the mounted persistent directory on your hosting service.
# DATA_DIR=/var/data
# Set NODE_ENV=production on the host to disable live reload and enable the Secure session cookie.
